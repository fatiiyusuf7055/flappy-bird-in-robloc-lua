-- ===== ÉTAT =====
local birdY = 300
local birdVel = 0
local pipes = {}
local score = 0
local bestScore = 0
local gameState = "waiting"
local spawnTimer = 0
local frameHeight = 600
local gameActive = true

local function createPipe()
    local gapY = math.random(120, frameHeight - 120 - PIPE_GAP)

    local topPipe = Instance.new("Frame")
    topPipe.Size = UDim2.new(0, PIPE_WIDTH, 0, gapY)
    topPipe.Position = UDim2.new(0, VIRTUAL_W, 0, 0)
    topPipe.BackgroundColor3 = Color3.fromRGB(80, 180, 60)
    topPipe.BorderSizePixel = 0
    topPipe.ZIndex = 2
    topPipe.Parent = frame

    local topCap = Instance.new("Frame")
    topCap.Size = UDim2.new(1, 6, 0, 20)
    topCap.Position = UDim2.new(0, -3, 1, -20)
    topCap.BackgroundColor3 = Color3.fromRGB(60, 150, 45)
    topCap.BorderSizePixel = 0
    topCap.ZIndex = 2
    topCap.Parent = topPipe

    local bottomPipe = Instance.new("Frame")
    bottomPipe.Size = UDim2.new(0, PIPE_WIDTH, 0, frameHeight - 60 - gapY - PIPE_GAP)
    bottomPipe.Position = UDim2.new(0, VIRTUAL_W, 0, gapY + PIPE_GAP)
    bottomPipe.BackgroundColor3 = Color3.fromRGB(80, 180, 60)
    bottomPipe.BorderSizePixel = 0
    bottomPipe.ZIndex = 2
    bottomPipe.Parent = frame

    local bottomCap = Instance.new("Frame")
    bottomCap.Size = UDim2.new(1, 6, 0, 20)
    bottomCap.Position = UDim2.new(0, -3, 0, 0)
    bottomCap.BackgroundColor3 = Color3.fromRGB(60, 150, 45)
    bottomCap.BorderSizePixel = 0
    bottomCap.ZIndex = 2
    bottomCap.Parent = bottomPipe

    table.insert(pipes, {
        top = topPipe,
        bottom = bottomPipe,
        x = VIRTUAL_W,
        scored = false
    })
end

local function resetGame()
    for _, pipe in ipairs(pipes) do
        pipe.top:Destroy()
        pipe.bottom:Destroy()
    end
    pipes = {}
    birdY = 300
    birdVel = 0
    score = 0
    scoreLabel.Text = "0"
    spawnTimer = 0
    msgLabel.Visible = false
    replayBtn.Visible = false
    gameState = "playing"
end

local function flap()
    if not gameActive then return end
    if gameState == "waiting" then resetGame() end
    if gameState == "playing" then
        birdVel = FLAP_FORCE
        wing.Rotation = -30
        task.delay(0.1, function() wing.Rotation = 0 end)
    end
end

local function gameOver()
    gameState = "gameover"
    if score > bestScore then bestScore = score end
    msgLabel.Text = "GAME OVER\nScore: " .. score .. "  |  Meilleur: " .. bestScore
    msgLabel.Visible = true
    replayBtn.Visible = true
end

-- Inputs clavier
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.Up then
        flap()
    end
end)

-- Tap tactile
hitbox.MouseButton1Click:Connect(function()
    if gameState == "gameover" then return end
    flap()
end)

hitbox.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        if gameState == "gameover" then return end
        flap()
    end
end)

-- Fermer (version executor)
local function closeGame()
    gameActive = false
    pcall(function() gui:Destroy() end)
    _G.__FlappyBirdLoaded = false
    _G.__FlappyBirdGUI = nil
end

closeBtn.MouseButton1Click:Connect(closeGame)
closeBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        closeGame()
    end
end)

-- Rejouer
replayBtn.MouseButton1Click:Connect(resetGame)
replayBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        resetGame()
    end
end)

frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateScale)
task.wait()
updateScale()

if isTouch and not UserInputService.MouseEnabled then
    msgLabel.Text = "📱 TAP pour voler"
elseif isTouch then
    msgLabel.Text = "TAP ou ESPACE pour voler"
else
    msgLabel.Text = "ESPACE ou CLIC pour voler"
end

-- Boucle principale
local lastTime = tick()
RunService.RenderStepped:Connect(function()
    if not gameActive then return end
    local now = tick()
    local dt = math.min(now - lastTime, 0.1)
    lastTime = now

    if gameState == "playing" then
        birdVel = birdVel + GRAVITY * dt
        birdY = birdY + birdVel * dt
        bird.Rotation = math.clamp(birdVel / 15, -25, 70)

        if birdY + BIRD_SIZE >= frameHeight - 60 then
            birdY = frameHeight - 60 - BIRD_SIZE
            gameOver()
        end
        if birdY < 0 then birdY = 0; birdVel = 0 end

        spawnTimer = spawnTimer + dt
        if spawnTimer >= PIPE_INTERVAL then
            spawnTimer = 0
            createPipe()
        end

        for i = #pipes, 1, -1 do
            local pipe = pipes[i]
            pipe.x = pipe.x - PIPE_SPEED * dt
            pipe.top.Position = UDim2.new(0, pipe.x, 0, 0)
            pipe.bottom.Position = UDim2.new(0, pipe.x, 0, pipe.top.AbsoluteSize.Y + PIPE_GAP)

            if not pipe.scored and pipe.x + PIPE_WIDTH < 100 then
                pipe.scored = true
                score = score + 1
                scoreLabel.Text = tostring(score)
            end

            if pipe.x + PIPE_WIDTH < 0 then
                pipe.top:Destroy()
                pipe.bottom:Destroy()
                table.remove(pipes, i)
            end
        end

        local birdLeft, birdRight = 100, 100 + BIRD_SIZE
        local birdTop, birdBottom = birdY, birdY + BIRD_SIZE

        for _, pipe in ipairs(pipes) do
            local pipeLeft, pipeRight = pipe.x, pipe.x + PIPE_WIDTH
            if birdRight > pipeLeft and birdLeft < pipeRight then
                local topPipeBottom = pipe.top.AbsoluteSize.Y
                local bottomPipeTop = topPipeBottom + PIPE_GAP
                if birdTop < topPipeBottom or birdBottom > bottomPipeTop then
                    gameOver()
                    break
                end
            end
        end
    end

    bird.Position = UDim2.new(0, 100, 0, birdY)
end)

